{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ppminer-dashboard",
      "runtimeExecutable": "ssh",
      "runtimeArgs": ["-N", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes", "-o", "ServerAliveInterval=30",
                      "-L", "5070:127.0.0.1:5070", "qa-3080"],
      "port": 5070
    },
    {
      "name": "ppminer-dashboard-local",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "ppminer", "web", "--port", "5071"],
      "port": 5071
    }
  ]
}
